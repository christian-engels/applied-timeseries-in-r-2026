{
  "name": "R",
      "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
      "hostRequirements": {
    "cpus": 4
  }, 
    "features": {
        "ghcr.io/rocker-org/devcontainer-features/r-apt:0": {
            // See: https://github.com/rocker-org/devcontainer-features/blob/main/src/r-apt/README.md#options
            //
            // Use RSupport (incl languageserver and httpgd) and bspm
            "vscodeRSupport": "full",
            "installBspm": true,
            //
            // And turn on Radian (R console), devtools, extre Markdown support and debugger
            // You can add each of these individually or jointly. See the table at
            // https://github.com/rocker-org/devcontainer-features/blob/main/src/r-apt/README.md#options
            "installRadian": true,
            "installDevTools": false,
            "installRMarkdown": false,
            "installVscDebugger": false,
            "useTesting": false
        },
         "ghcr.io/devcontainers/features/git:1": {}
    },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "REditorSupport.r",
        "REditorSupport.r-lsp",
        "RDebugger.r-debugger",
        "janisdd.vscode-edit-csv",
        "mechatroner.rainbow-csv",
        "formulahendry.code-runner",
        "Posit.air-vscode",
        "mathematic.vscode-pdf"
      ],
      "settings": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "r.rterm.linux": "/usr/local/bin/radian",
        "r.bracketedPaste": true,
        "r.sessionWatcher": true,
        "r.plot.useHttpgd": true,
        "r.alwaysUseActiveTerminal": true,
        "r.plot.viewer": "Viewer",
        "r.rterm.option": ["--no-save", "--no-restore", "--quiet"],
        "r.editor.tabSize": 2,
        "r.editor.insertSpaces": true,
        "r.editor.formatOnSave": true,
        "r.editor.formatOnType": true,
        "r.lsp.enabled": true,
        "r.lsp.diagnostics": false,
        "keyboard.dispatch": "keyCode",
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "files.associations": {
          "*.rmd": "rmd"
        },
        "[rmd]": {
          "editor.wordWrap": "on"
        },
        "[r]": {
          "editor.defaultFormatter": "Posit.air-vscode",
          "editor.formatOnSave": true,
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.detectIndentation": false,
          "editor.shortcuts.r.pipe": true,
          "editor.snippets.codeActions.enabled": true
        },
        "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
        "terminal.integrated.defaultProfile.linux": "R Terminal",
        "terminal.integrated.tabs.focusMode": "singleClick",
        "extensions.ignoreRecommendations": true
      }
    }
  },
  "postCreateCommand": "chmod +x ${containerWorkspaceFolder}/save-work.sh"
}
